# Copy relevant lines into repo root `.env` (chat-reply-server loads `.env` from repo root).

# Port (default 8777)
# CHAT_REPLY_PORT=8777

# --- Backend: local Ollama (faster local generation) ---
# Force Ollama even when OPENAI_API_KEY is set:
# CHAT_REPLY_USE_LOCAL=1
# Or explicitly:
# CHAT_REPLY_BACKEND=ollama

CHAT_REPLY_OLLAMA_MODEL=hf.co/DavidAU/L3.2-Rogue-Creative-Instruct-Uncensored-Abliterated-7B-GGUF:Q4_K_M
OLLAMA_HOST=http://127.0.0.1:11434
# Shorter generation = faster (default 320 if unset)
# CHAT_REPLY_OLLAMA_NUM_PREDICT=320

# --- Backend: OpenAI ---
# OPENAI_API_KEY=sk-...
# CHAT_REPLY_BACKEND=openai
# CHAT_REPLY_MODEL=gpt-4o-mini
# CHAT_REPLY_MAX_COMPLETION_TOKENS=450
# CHAT_REPLY_TEMPERATURE=0.68
