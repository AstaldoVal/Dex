{
  "manifest_version": 3,
  "name": "Dex LinkedIn Job Capture",
  "version": "1.9.43",
  "description": "Capture job details from LinkedIn for Dex digest, Booking car capture, ATS autofill, plus optional side panel for LLM chat reply suggestions (dating or any site; local server).",
  "permissions": [
    "storage",
    "nativeMessaging",
    "contextMenus",
    "sidePanel",
    "tabs",
    "notifications",
    "alarms"
  ],
  "side_panel": {
    "default_path": "sidepanel-chat.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://www.booking.com/*",
    "https://cars.booking.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:8766/*",
    "http://127.0.0.1:8766/*",
    "http://127.0.0.1:8777/*",
    "http://localhost:8777/*",
    "https://*.myworkdayjobs.com/*",
    "https://jobs.gem.com/*",
    "https://*.recruitmentplatform.com/*",
    "https://match-club.club/*",
    "https://*.match-club.club/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/view/*",
        "https://www.linkedin.com/comm/jobs/view/*"
      ],
      "js": [
        "dex-error-guard.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/feed",
        "https://www.linkedin.com/feed/",
        "https://www.linkedin.com/feed/*"
      ],
      "js": [
        "dex-error-guard.js",
        "feed-capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/search/results/content/*"
      ],
      "js": [
        "dex-error-guard.js",
        "trend-capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/mynetwork/grow/",
        "https://www.linkedin.com/in/*"
      ],
      "js": [
        "dex-error-guard.js",
        "hiring-managers-capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/jobs/search/*",
        "https://www.linkedin.com/jobs/search-results/*",
        "https://www.linkedin.com/jobs/collections/*"
      ],
      "js": [
        "dex-error-guard.js",
        "search-capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.booking.com/*"
      ],
      "js": [
        "booking-cars-lis-bootstrap.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.booking.com/cars/*"
      ],
      "js": [
        "dex-error-guard.js",
        "booking-cars-capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cars.booking.com/*"
      ],
      "js": [
        "dex-error-guard.js",
        "booking-cars-capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:8766/*",
        "http://127.0.0.1:8766/*"
      ],
      "js": [
        "dex-error-guard.js",
        "digest-page.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jobs.ashbyhq.com/*",
        "https://*.careers.hibob.com/*",
        "https://jobs.elastic.co/*",
        "https://www.okta.com/*",
        "https://careers.fyul.com/*",
        "https://app.navero.me/*",
        "https://*.fountain.com/*",
        "https://*.pinpointhq.com/*",
        "https://*.greenhouse.io/*",
        "https://*.recruitee.com/*",
        "https://jobs.gem.com/*",
        "https://*.recruitmentplatform.com/*"
      ],
      "js": [
        "dex-error-guard.js",
        "ats-autofill.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.myworkdayjobs.com/*"
      ],
      "js": [
        "dex-error-guard.js",
        "workday-ats.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://match-club.club/*",
        "https://*.match-club.club/*"
      ],
      "js": [
        "match-club-inventory.js",
        "match-club-chat.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Dex: открыть панель ответов в чатах (или ПКМ по странице)"
  }
}
