# OS
.DS_Store
Thumbs.db

# Chromium / Electron browser profile caches (never commit — may embed API keys from extensions)
undefined/
**/Code Cache/
**/Cache_Data/
**/GPUCache/
**/Service Worker/CacheStorage/
**/Session Storage/
**/Local Storage/
**/shared_proto_db/

# Editor / IDE
.vscode/*
!.vscode/extensions.json
# Ignore Cursor junk under `.cursor/` but keep tracked subtrees (see negations below).
# A bare `.cursor/` line would exclude the whole tree and block `!.cursor/rules/` for new files.
.cursor/*
# Dex slash commands (topic-based menu) — keep in repo
!.cursor/commands/
!.cursor/commands/**
# Cursor slash autosuggest wrappers (synced from dex menus + commands)
!.cursor/skills/
!.cursor/skills/**
!.cursor/slash-manifest.json
# Cursor hooks (project automation; keep in repo)
!.cursor/hooks.json
!.cursor/hooks/
!.cursor/hooks/**
# Hook debug log (local only)
.cursor/hooks/session-start-last-run.log
# Cursor rules (AI guidance; keep in repo for auditable diffs)
!.cursor/rules/
!.cursor/rules/**
*.swp
*.swo

# Python
**/__pycache__/

# Banda presentations: flat .txt previews (local cache only; not uploaded to Drive)
.scripts/.cache/banda-presentations-previews/

# Node (if MCP servers are used)
node_modules/
.env
# LinkedIn browser profile (job-search filter with --login)
**/.playwright-linkedin
.env.local
.millennium_sms_code
credentials.json
credentials_*.json
gmail_token.json
gmail_token.json.backup
google_calendar_token.json
google_drive_token.json
