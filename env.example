# Dex - API Keys Configuration
#
# NOTE: This file is created automatically by /setup if you enable automatic meeting processing.
# Most users don't need to manually edit this file.
#
# ===========================================
# What needs API keys?
# ===========================================
#
# 99% of Dex features work through Cursor - NO setup needed!
#
# API keys are ONLY for:
# - Automatic background meeting processing (runs when Cursor is closed)
# - /prompt-improver calling Anthropic API directly (optional optimization)
#
# ===========================================
# API Keys (add ONE of these)
# ===========================================
#
# The system auto-detects which provider you have configured.
# Priority order: Anthropic > OpenAI > Gemini

# Anthropic (Claude) - Best for /prompt-improver
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (GPT-4)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Google Gemini - Has generous free tier
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-your-key-here

# Cursor Agent CLI for Paperclip (default: annual subscription + model auto).
# Default billing: subscription — run once: agent login (browser). Do NOT rely on CURSOR_API_KEY.
# Optional API billing (pay-per-use, not subscription Auto): PAPERCLIP_CURSOR_BILLING=api + key below.
# PAPERCLIP_CURSOR_BILLING=subscription
# CURSOR_API_KEY=crsr_your-key-here

# ===========================================
# Job search: LinkedIn auto-login (optional)
# ===========================================
# If set, "npm run job-search:linkedin-login" will fill the form and log in automatically.
# Otherwise you log in manually in the browser and press Enter in the terminal.
# Same session is used for digest filter and fetch descriptions.
#
# LINKEDIN_EMAIL=your.email@example.com
# LINKEDIN_PASSWORD=your-password

# Skip fetching job descriptions from LinkedIn (e.g. when banned). Pipeline still runs 3b (summaries for cached) and 4 (Teal for all jobs including RSS).
# SKIP_LINKEDIN_DESCRIPTIONS=1

# ===========================================
# Job search: parse LinkedIn Job Alert emails
# ===========================================
# Optional. If set, daily job-search script will read your inbox (IMAP),
# find emails from LinkedIn, extract job links, and filter for iGaming/PM relevance.
#
# Gmail (English): Google Account → Security → 2-Step Verification → App passwords
#   → create an app password for Mail/Other, then paste it here.
#
# JOBSEARCH_EMAIL_USER=your.email@gmail.com
# JOBSEARCH_EMAIL_PASSWORD=your-16-char-app-password
# JOBSEARCH_IMAP_HOST=imap.gmail.com
# JOBSEARCH_IMAP_PORT=993

# ===========================================
# Teal job tracker + Chrome (job-search / full-flow)
# ===========================================
# Teal Playwright (steps 6–10): no focus steal on macOS — agent should keep this in .env:
TEAL_CHROME_LAUNCH_MODE=pipe_minimized
#
# LinkedIn Dex extension (steps 1–4): same profile pool as Teal (teal/.chrome-profile*),
# open -g via dex-chrome-open-background.cjs. Do NOT set DEX_CHROME_PROFILE_DIRECTORY unless legacy.
#
# Optional Teal login in automation window (or log in once per pool profile):
# TEAL_EMAIL=your@email.com
# TEAL_PASSWORD=your-password
#
# Override single profile dir (rare; pool is default):
# TEAL_CHROME_PROFILE=/absolute/path/to/.chrome-profile
#
# Legacy: system macOS Chrome profile instead of pool:
# DEX_CHROME_USE_SYSTEM_PROFILE=1
# DEX_CHROME_PROFILE_DIRECTORY=Profile 1
#
# Legacy: Chrome steals focus (debug only):
# DEX_CHROME_ALLOW_FOCUS_STEAL=1
# DEX_LINKEDIN_USE_OPEN=1

# ===========================================
# Applicator full-flow-v2 (steps 6–10)
# ===========================================
# Applicator iGaming & Compliance etalon template (same family as Teal iGaming/Compliance). Default: 2c919269-d8cb-40bd-9c3a-d7908df104af
# APPLICATOR_TEMPLATE_RESUME_ID=2c919269-d8cb-40bd-9c3a-d7908df104af
# APPLICATOR_EMAIL=your@email.com
# APPLICATOR_PASSWORD=your-password
# Step 9: parallel sub-agents by default (orchestrator + one Claude per section/company).
# APPLICATOR_REVIEW_MODE=parallel
# APPLICATOR_PARALLEL_CONCURRENCY=8
# APPLICATOR_ORCHESTRATOR_SKIP_LLM=1
# APPLICATOR_ORCHESTRATOR_TIMEOUT_MS=180000
# APPLICATOR_REVIEW_SKIP_LLM=1
# APPLICATOR_SKIP_STEP10_EVAL=1
# Legacy monolithic (one Claude for all blocks): APPLICATOR_REVIEW_MODE=monolithic
# Override review command:
# APPLICATOR_REVIEW_LLM_COMMAND=node .scripts/job-search/full-flow-v2/applicator-claude-resume-review.cjs

# ===========================================
# Google Calendar MCP (optional)
# ===========================================
# Path to OAuth 2.0 Desktop client JSON from Google Cloud Console.
# Default: Credentials/personal/credentials.json (see Credentials/README.md).
# GOOGLE_CALENDAR_CREDENTIALS_PATH=/path/to/credentials.json
# Where to store the OAuth token after first sign-in (default: Credentials/personal/google_calendar_token.json).
# GOOGLE_CALENDAR_TOKEN_PATH=/path/to/google_calendar_token.json
#
# Work account: Credentials/google-work/ (symlinked as .claude/google-work/; see .claude/reference/google-work-account-setup.md).

# ===========================================
# Portal invoices (Simas, Lisboagas, IBELECTRa)
# ===========================================
# Used by .scripts/invoices/*-login.cjs and *-download-invoices.cjs. Never run in background (browser must be visible).
#
# SIMAS (water, Oeiras)
# SIMAS_USER=your-username
# SIMAS_PASSWORD=your-password
#
# Lisboagas / Galp Balcão Digital (gas)
# LISBOAGAS_USER=your-username
# LISBOAGAS_PASSWORD=your-password
#
# IBELECTRa (electricity, clientes.ibelectra.com)
# IBELECTRA_USER=your-username
# IBELECTRA_PASSWORD=your-password

# ===========================================
# Bank: Millennium BCP (transaction confirmations)
# ===========================================
# Used by .scripts/bank/millennium-bcp-download-transactions.cjs. Never run in background (browser visible for 2FA).
# Auth: Código de Utilizador → 3 positions of Código Multicanal (7 digits) → SMS code.
#
# MILLENNIUM_BCP_USER=your-codigo-utilizador
# MILLENNIUM_BCP_MULTICANAL=1234567
# Optional: script that prints SMS code to stdout. Example: .scripts/bank/get-sms-millennium.sh (reads last Messages; needs Full Disk Access). Timeout ~90s.
# MILLENNIUM_BCP_GET_SMS_SCRIPT=/absolute/path/to/.scripts/bank/get-sms-millennium.sh

# ===========================================
# GrowthBook experiment CLI
# ===========================================
# Used by npm run growthbook:create-experiment (feature + draft experiment + link).
#
# GB_API_KEY=secret_...
# GB_DATASOURCE_ID=your_mixpanel_datasource_id
# GB_BASE_URL=https://api.growthbook.io/api/v1
# GB_ENVIRONMENTS=dev
# GB_PROJECT_ID=
# GB_ASSIGNMENT_QUERY_ID=
