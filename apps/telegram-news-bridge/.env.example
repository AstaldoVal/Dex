TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Шлях до бази сесії Telethon (без суфікса .session). Якщо порожньо: VAULT_PATH/.claude/telegram/telegram_bridge
# (окремо від MCP: .claude/mcp/user-telegram.json → …/telegram/telegram)
TELEGRAM_SESSION_PATH=
VAULT_PATH=

# Секрет для REST Bearer і (за відсутності BRIDGE_JWT_SECRET) для JWT WebSocket
BRIDGE_API_SECRET=change-me
BRIDGE_JWT_SECRET=

# Канали-джерела: JSON або залишити порожнім для дефолту uaonlii + real_kyiv
# NEWS_SOURCE_MAP={"uaonlii":"1233777422","real_kyiv":"1181169156"}
# Або список peers (перший → uaonlii, другий → real_kyiv): числові id як PeerChannel
# NEWS_SOURCE_CHANNELS=1233777422,1181169156
# NEWS_SOURCE_CHANNELS=@uaonlii,1181169156

# Канали з дашборду (POST /channels/watch) зберігаються у JSON; за замовчуванням — поруч із TELEGRAM_SESSION_PATH
# BRIDGE_WATCHLIST_PATH=/path/to/telegram_news_watchlist.json

# Куди публікувати переписаний пост (@channel або id)
NEWS_TARGET_CHANNEL=

# Ollama для POST /rewrite
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Ім’я моделі як у `ollama list` (дефолт llama3.2 має бути з pull; інакше — свій тег)
OLLAMA_MODEL=llama3.2

# CORS: якщо дашборд на іншому origin (наприклад Vercel), додайте URL через кому
# BRIDGE_CORS_ORIGINS=https://your-app.vercel.app

BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765
