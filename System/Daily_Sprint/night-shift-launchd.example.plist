<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dex.day-sprint.night-shift</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "$HOME/Development/DEX" &amp;&amp; export VAULT_PATH="$HOME/Development/DEX" &amp;&amp; npm run day-sprint:night-shift</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/dex-day-sprint-night-shift.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/dex-day-sprint-night-shift.err</string>
</dict>
</plist>
