{
  "mcpServers": {
    "work-mcp": {
      "type": "stdio",
      "command": "{{VAULT_PATH}}/.venv/bin/python",
      "args": [
        "{{VAULT_PATH}}/core/mcp/work_server.py"
      ],
      "env": {
        "VAULT_PATH": "{{VAULT_PATH}}"
      }
    },
    "calendar-mcp": {
      "type": "stdio",
      "command": "{{VAULT_PATH}}/.venv/bin/python",
      "args": [
        "{{VAULT_PATH}}/core/mcp/calendar_server.py"
      ],
      "env": {
        "VAULT_PATH": "{{VAULT_PATH}}"
      }
    },
    "granola-mcp": {
      "type": "stdio",
      "command": "{{VAULT_PATH}}/.venv/bin/python",
      "args": [
        "{{VAULT_PATH}}/core/mcp/granola_server.py"
      ],
      "env": {
        "VAULT_PATH": "{{VAULT_PATH}}"
      }
    },
    "career-mcp": {
      "type": "stdio",
      "command": "{{VAULT_PATH}}/.venv/bin/python",
      "args": [
        "{{VAULT_PATH}}/core/mcp/career_server.py"
      ],
      "env": {
        "VAULT_PATH": "{{VAULT_PATH}}"
      }
    },
    "dex-improvements-mcp": {
      "type": "stdio",
      "command": "{{VAULT_PATH}}/.venv/bin/python",
      "args": [
        "{{VAULT_PATH}}/core/mcp/dex_improvements_server.py"
      ],
      "env": {
        "VAULT_PATH": "{{VAULT_PATH}}"
      }
    },
    "resume-mcp": {
      "type": "stdio",
      "command": "{{VAULT_PATH}}/.venv/bin/python",
      "args": [
        "{{VAULT_PATH}}/core/mcp/resume_server.py"
      ],
      "env": {
        "VAULT_PATH": "{{VAULT_PATH}}"
      }
    },
    "update-checker": {
      "type": "stdio",
      "command": "{{VAULT_PATH}}/.venv/bin/python",
      "args": [
        "{{VAULT_PATH}}/core/mcp/update_checker.py"
      ],
      "env": {
        "VAULT_PATH": "{{VAULT_PATH}}"
      }
    },
    "onboarding-mcp": {
      "type": "stdio",
      "command": "{{VAULT_PATH}}/.venv/bin/python",
      "args": [
        "{{VAULT_PATH}}/core/mcp/onboarding_server.py"
      ],
      "env": {
        "VAULT_PATH": "{{VAULT_PATH}}"
      }
    },
    "nanobanana-mcp": {
      "type": "stdio",
      "command": "{{VAULT_PATH}}/.venv/bin/python",
      "args": [
        "{{VAULT_PATH}}/core/mcp/nanobanana_server.py"
      ],
      "env": {
        "VAULT_PATH": "{{VAULT_PATH}}"
      }
    },
    "reminders-mcp": {
      "type": "stdio",
      "command": "{{VAULT_PATH}}/.venv/bin/python",
      "args": [
        "{{VAULT_PATH}}/core/mcp/reminders_server.py"
      ],
      "env": {
        "VAULT_PATH": "{{VAULT_PATH}}"
      }
    },
    "qmd": {
      "command": "qmd",
      "args": ["mcp"]
    },
    "atlassian-mcp": {
      "command": "npx",
      "args": ["-y", "mcp-remote@latest", "https://mcp.atlassian.com/v1/sse"]
    }
